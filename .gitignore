/target
**/*.rs.bk
*.db
*.db-shm
*.db-wal

# Generated by the Selarust PWA generator (build.rs). Safe to delete: they are
# recreated on every `cargo build` / `selarust build`.
/app/public/manifest.webmanifest
/app/public/sw.js
/app/public/icons/
# Runtime Workbox disalin dari crates/selarust-build/vendor/workbox saat build.
/app/public/workbox/

# Nilai lokal untuk docker-compose.yml (bisa memuat kredensial/URL lokal).
# Contoh yang boleh dibagikan ada di .env.example.
.env
