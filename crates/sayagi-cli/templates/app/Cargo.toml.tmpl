[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.80"

# Proyek mandiri: jangan ikut workspace milik folder induk.
[workspace]

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
sayagi = { path = "{{sayagi_root}}/crates/sayagi" }
leptos = "0.8"
leptos_router = "0.8"
leptos_meta = "0.8"
serde = { version = "1", features = ["derive"] }

axum = { version = "0.8", optional = true }
leptos_axum = { version = "0.8", optional = true }
tokio = { version = "1", optional = true, features = ["rt-multi-thread", "macros", "net"] }
tower-http = { version = "0.6", optional = true, features = ["compression-gzip"] }
wasm-bindgen = { version = "0.2.106", optional = true }
console_error_panic_hook = { version = "0.1", optional = true }

[build-dependencies]
sayagi-build = { path = "{{sayagi_root}}/crates/sayagi-build" }

[features]
default = []

ssr = [
    "dep:axum",
    "dep:leptos_axum",
    "dep:tokio",
    "dep:tower-http",
    "leptos/ssr",
    "leptos_meta/ssr",
    "leptos_router/ssr",
    "sayagi/ssr",
]

hydrate = [
    "dep:wasm-bindgen",
    "dep:console_error_panic_hook",
    "sayagi/hydrate",
]

[package.metadata.leptos]
output-name = "{{project_name}}"
site-root = "target/site"
site-pkg-dir = "pkg"
style-file = "style/main.css"
assets-dir = "public"
site-addr = "{{site_addr}}"
reload-port = 3001
browserquery = "defaults"
# Catatan: `hash-files` dibiarkan mati karena merusak hot-reload CSS di watch mode.
bin-features = ["ssr"]
bin-default-features = false
lib-features = ["hydrate"]
lib-default-features = false
lib-profile-release = "wasm-release"

# Profil hemat ukuran untuk bundle Wasm di mode release.
[profile.wasm-release]
inherits = "release"
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"
