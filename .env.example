# Nilai yang dibaca `docker-compose.yml`. Salin menjadi `.env` (diabaikan git)
# lalu sesuaikan seperlunya:
#
#   cp .env.example .env
#
# Semua baris boleh dihapus: compose memakai bawaan yang tertulis di
# docker-compose.yml. Nilai yang sama juga bisa diberikan langsung dari shell,
# mis. `SELARUST_PORT=3000 docker compose up`, dan shell menang atas `.env`.

# --- Identitas & port -------------------------------------------------------
# Nama proyek compose; menentukan prefix nama container dan volume.
SELARUST_PROJECT=selarust
# Image yang dipakai/dibangun. Bisa diarahkan ke registry,
# mis. `ghcr.io/<user>/selarust:1.2.3`.
SELARUST_IMAGE=selarust-todo:latest
# Port di host (bawaan 8080 agar tidak bentrok dengan `cargo leptos watch`).
SELARUST_PORT=8080
# Port di dalam container; sekaligus alamat listen Leptos.
SELARUST_APP_PORT=3000
# Antarmuka host: `0.0.0.0` (bawaan, bisa diakses perangkat lain di jaringan)
# atau `127.0.0.1` untuk lokal saja.
SELARUST_BIND=0.0.0.0
# Berkas env tambahan yang ikut diteruskan ke container (boleh tidak ada).
# SELARUST_ENV_FILE=.env

# --- Data -------------------------------------------------------------------
# URL SQLite; path absolut (seperti di bawah) dipakai apa adanya oleh
# `db::resolve_url`, sedangkan path relatif diresolusi terhadap direktori biner.
SELARUST_DATABASE_URL=sqlite:///data/selarust.db
# Volume (bawaan) atau path host, mis. `./data` untuk bind mount.
SELARUST_DATA_DIR=selarust-data

# --- Runtime Leptos ---------------------------------------------------------
# `DEV` menyalakan auto-reload Leptos; untuk container produksi biarkan `PROD`.
LEPTOS_ENV=PROD
LEPTOS_SITE_ROOT=/app/site
# Nama berkas bundle di `/pkg`; samakan dengan `output-name` di app/Cargo.toml.
LEPTOS_OUTPUT_NAME=mobile-pwa

# --- Operasional ------------------------------------------------------------
SELARUST_RESTART=unless-stopped
SELARUST_HEALTHCHECK_INTERVAL=30s
